# Postgres connection string. For local dev with docker-compose:
DATABASE_URL=postgres://civitas:civitas_dev@localhost:5432/civitas

# Anthropic SDK — used by document classifier and extractors
ANTHROPIC_API_KEY=

# Voyage embeddings — used for specialty/capability/RFP semantic match
VOYAGE_API_KEY=

# Existing AWS / app vars (see README for full list)
AWS_REGION=us-east-1
AWS_S3_BUCKET=civitas-ai
JWT_SECRET=
